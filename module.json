{
  "id": "wfrp4e-customizer-apps",
  "title": "Drowsy's WFRP4e Customizers",
  "description": "Vue-powered customization applications for the WFRP4e Foundry system.",
  "version": "2.0.1",
  "authors": [
    {
      "name": "Jeremy Glebe"
    }
  ],
  "compatibility": {
    "minimum": "13",
    "verified": "14"
  },
  "relationships": {
    "systems": [
      {
        "id": "wfrp4e",
        "type": "system"
      }
    ]
  },
  "esmodules": [
    "scripts/wfrp4e-customizer-apps.mjs"
  ],
  "styles": [
    "styles/wfrp4e-customizer-apps.css"
  ],
  "languages": [
    {
      "lang": "en",
      "name": "English",
      "path": "lang/en.json"
    }
  ],
  "packs": [
    {
      "name": "sample-species-traits",
      "label": "Sample Species Traits",
      "type": "Item",
      "system": "wfrp4e",
      "path": "packs/sample-species-traits"
    },
    {
      "name": "sample-species-talents",
      "label": "Sample Species Talents",
      "type": "Item",
      "system": "wfrp4e",
      "path": "packs/sample-species-talents"
    },
    {
      "name": "sample-species-journals",
      "label": "Sample Species Journals",
      "type": "JournalEntry",
      "path": "packs/sample-species-journals"
    },
    {
      "name": "effect-builders",
      "label": "Effect Builders",
      "type": "Macro",
      "path": "packs/effect-builders"
    }
  ],
  "packFolders": [
    {
      "name": "Drowsy's WFRP4e Customizers - Sample Species",
      "sorting": "a",
      "packs": [
        "sample-species-traits",
        "sample-species-talents",
        "sample-species-journals"
      ]
    }
  ],
  "documentTypes": {
    "Item": {
      "species": {
        "htmlFields": [
          "description.value",
          "gmdescription.value"
        ]
      }
    }
  },
  "url": "https://github.com/jeremyglebe/Foundry.Warhammer.Drowsy-Customizers",
  "manifest": "https://github.com/jeremyglebe/Foundry.Warhammer.Drowsy-Customizers/releases/latest/download/module.json",
  "download": "https://github.com/jeremyglebe/Foundry.Warhammer.Drowsy-Customizers/releases/download/v2.0.1/module.zip"
}
